# DiamondScout AI - DB 연결 정보 예시 파일
# 이 파일을 .env로 복사한 뒤 실제 값으로 채워서 사용하세요. 실제 비밀번호는 .env에만
# 넣고 이 예시 파일이나 README, 코드에는 절대 하드코딩하지 않습니다.
#
#   cp .env.example .env
#
# DB_HOST/DB_PORT/DB_USER/DB_NAME 중 하나라도 비어 있으면 DB 로깅 기능은 비활성화되고
# (콘솔 경고만 출력) 앱의 나머지 기능은 그대로 동작합니다.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=diamondscout_ai

# Instant Scout Q&A의 LLM 백엔드. 기본값 ollama는 로컬에서 상시 구동 중인 Ollama
# (http://localhost:11434, gemma2:latest)를 그대로 쓴다. Ollama를 띄울 수 없는 공개
# 배포 환경(HF Spaces 등)에서만 groq로 바꾸고 GROQ_API_KEY를 채운다.
# GROQ_API_KEY가 비어 있으면 LLM_BACKEND=groq로 설정해도 규칙 기반 폴백으로 동작한다.
LLM_BACKEND=ollama
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
