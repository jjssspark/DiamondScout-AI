# Claude Code (로컬 전용)
CLAUDE.md
.claude/

# 환경
.env
.env.local

# 캐시
__pycache__/
*.pyc
.DS_Store
.pytest_cache/
.ruff_cache/

# 의존성
node_modules/
venv/
.venv/

# 빌드
dist/
build/
.next/

# 산출물
output/*
!output/screenshots/
# README가 상단에 거는 데모 GIF와 전체 영상. 저장소에 없으면 GitHub에서 깨진다.
# 셋 합쳐 6MB대라 히스토리에 남겨도 감당된다.
!output/demo/
# 지표 산출물은 문서가 출처로 인용한다. 저장소에 없으면 수치를 확인할 방법이 없다.
# 전부 합쳐 수백 KB라 히스토리에 남겨도 부담이 없다.
!output/metrics/
# 목업은 UI 승인 근거라 히스토리에 남긴다. 마젠타 원본(장당 1.2~1.5MB)은 제외하고
# 크로마키 처리된 cut-*.png만 포함.
!output/mockups/
output/mockups/*
!output/mockups/dugout-console.html
!output/mockups/gemini-batter-scene-prompt.md
!output/mockups/assets/
output/mockups/assets/*
!output/mockups/assets/cut-*.png
reports/
uploads/
*.zip
*.log

# 대용량 데이터·모델 (git 저장소 무게 관리, GitHub 100MB 제한)
data/raw/
data/processed/next_pitch_dataset_*.csv
# 타자 x 구종 이벤트 표(4.9MB). 기본 파이프라인은 안 쓴다 - 미채택된 실험을
# --with-batter-pitch로 재현할 때만 필요하고, preprocess_statcast.py로 다시 만들 수 있다.
data/processed/batter_matchup_events_*.csv
data/processed/enriched_*.parquet
data/processed/model_outputs/
models/*.joblib
models/*.keras
docs/*.pdf

# Gradio 자동 생성 캐시
.gradio/

